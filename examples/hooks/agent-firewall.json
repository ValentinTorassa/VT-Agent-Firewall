{
  "sandbox_root": ".",
  "protected_paths": [
    ".env",
    ".envrc",
    ".mcp.json",
    ".claude",
    ".codex",
    ".git/config",
    ".git/hooks"
  ],
  "protected_names": [
    ".env",
    ".env.*",
    ".envrc",
    "*.pem",
    "*.key",
    "id_rsa*",
    "id_ed25519*",
    ".netrc",
    ".npmrc",
    ".pypirc",
    ".aws",
    ".ssh",
    ".gnupg"
  ],
  "secret_files": [
    ".env",
    ".env.local"
  ],
  "writable_dirs": [
    "src",
    "tests",
    "docs"
  ],
  "shell_allowlist": [
    "ls",
    "grep",
    "cat",
    "head",
    "tail",
    "find",
    "wc"
  ],
  "shell_forbidden_args": {
    "find": [
      "-exec",
      "-execdir",
      "-delete"
    ]
  },
  "network": {
    "mode": "deny_all"
  },
  "mcp_registry": {}
}
